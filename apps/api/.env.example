# Copy to .env (never commit .env). Values below match compose.yaml.
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
METRICS_ADDR=:9090

DATABASE_URL=postgres://cf:cf@localhost:5433/codingfoding?sslmode=disable
DB_MAX_CONNS=20
REDIS_URL=redis://localhost:6380/0

# 32+ random bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Public web origin (email links) and allowed browser origins.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

SMTP_ADDR=localhost:1025
MAIL_FROM="Coding Foding <no-reply@codingfoding.dev>"
WORKER_CONCURRENCY=10

# Manual payments: the bKash/Nagad numbers learners send money to (leave one empty to hide it).
PAY_BKASH_NUMBER=
PAY_NAGAD_NUMBER=
